{
  "name": "mesh-shared-timer",
  "version": "0.1.1",
  "description": "A calm shared countdown that keeps every device in the room on the same clock.",
  "type": "module",
  "private": false,
  "homepage": "https://baditaflorin.github.io/mesh-shared-timer/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baditaflorin/mesh-shared-timer.git"
  },
  "bugs": {
    "url": "https://github.com/baditaflorin/mesh-shared-timer/issues"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "bash scripts/build-pages.sh",
    "preview": "vite preview --host 0.0.0.0",
    "pages-preview": "vite preview --host 0.0.0.0 --port 4174",
    "smoke": "bash scripts/smoke.sh",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:install": "playwright install chromium",
    "test:leak": "MESH_RUN_LEAK_TEST=1 playwright test tests/e2e/memory-leak.spec.ts",
    "demo:record": "DEMO_SCENARIO=tests/demo/scenario.mjs DEMO_OUT=docs bash ../mesh-common/scripts/record-demo.sh"
  },
  "dependencies": {
    "@baditaflorin/mesh-common": "file:../mesh-common",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "y-webrtc": "^10.3.0",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "ws": "8.21.3"
  },
  "engines": {
    "node": ">=22"
  }
}
